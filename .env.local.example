# Copy this file to .env.local (which IS gitignored) and put your real values there.
# Never put real secrets in this .example file — it's tracked by git.

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role — server-only, bypasses RLS. Used by the cron endpoint.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — for /motivation endpoint
OPENAI_API_KEY=sk-...

# Gmail SMTP — for the daily afternoon reminder email
# 1. Enable 2-Step Verification on the Gmail account
# 2. Generate an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_FROM_NAME=75 Challenge

# Vercel Cron secret — long random string. Vercel sends it as Bearer token.
CRON_SECRET=change-me-to-a-long-random-string

# Base URL for magic-link redirects and email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
